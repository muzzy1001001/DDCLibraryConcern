<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DDC Library Concerns Hub</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <!-- Hero Section -->
    <section class="hero">
        <!-- Background image placeholder — replace /images/hero-bg.jpg with actual library photo -->
        <div class="hero-bg"></div>
        <img src="/images/background.jpg" alt="Davao Doctors College Library" class="hero-bg" onerror="this.style.display='none'">
        <div class="hero-overlay"></div>

        <div class="hero-content">

            <div class="greeting"><%= greeting %></div>
            <h1>DDC Library</h1>

            <div class="hours-badge">
                <span>Open Daily: 8:00 AM – 7:00 PM</span>
            </div>
        </div>
    </section>

    <!-- Main Content -->
    <main class="container">
        <div class="cards">
            <!-- Card 1 -->
            <a href="<%= urls.guide %>" target="_blank" rel="noopener noreferrer" class="card">
                <div class="card-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                        <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
                    </svg>
                </div>
                <div class="card-title">Book a Discussion Room</div>
                <div class="card-desc">View the step-by-step scheduling guide.</div>
            </a>

            <!-- Card 2 -->
            <a href="<%= urls.calendar %>" target="_blank" rel="noopener noreferrer" class="card">
                <div class="card-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                </div>
                <div class="card-title">View Room Calendar</div>
                <div class="card-desc">Check real-time availability of discussion rooms.</div>
            </a>

            <!-- Card 3 -->
            <a href="<%= urls.clinic %>" target="_blank" rel="noopener noreferrer" class="card">
                <div class="card-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polygon points="10 8 16 12 10 16 10 8"></polygon>
                    </svg>
                </div>
                <div class="card-title">Research Clinic</div>
                <div class="card-desc">Learn how to avail the DDC Library Research Clinic.</div>
            </a>
        </div>
    </main>
</body>
</html>
